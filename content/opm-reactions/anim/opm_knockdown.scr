//----------------------------------------------------------------------------
// Added in OPM (content/opm-reactions): a man knocked off his feet by a blast
// or a heavy round that did not kill him, who gets up again.
//
// Called from anim/pain.scr. While he is down he plays an opm_down animation,
// which the client sees and makes him a ragdoll for (cg_ragdoll.cpp): his body
// falls where the blow sends it. Once it has settled the client says where it
// lies (opm_kdpose: opm_kd_face, opm_kd_pelvis, opm_kd_yaw, opm_kd_ready on
// him), and he is stood up from there by an opm_getup animation, motion
// captured (generate.py), lined up so that he starts where his body is. His
// AI waits all the while, as it does through any pain.
//
// set g_opm_paindebug 1 prints what is decided; g_opm_knockdown 0 turns it
// off, 2 knocks a man down at every hit (for testing).
//----------------------------------------------------------------------------

// Whether this hit knocks him down: 1 or 0.
should:
	local.mod = self.fact.meansofdeath
	local.damage = self.fact.damage

	// Single player only: where he lies is the client's to say (opm_kdpose).
	if (getcvar "g_gametype" != "0" || getcvar "g_opm_knockdown" == "0")
		end 0
	// already down: he stays down
	if (self.opm_kd_down == 1)
		end 1
	// for testing: every hit
	if (getcvar "g_opm_knockdown" == "2")
		end 1

	switch (self.position)
	{
	prone:
	pronewalk:
		end 0
	}

	// a blast
	if (local.mod == 9 || local.mod == 10 || local.mod == 14 || local.mod == 16 || local.mod == 29)
	{
		if (local.damage >= 15)
			end 1
		end 0
	}

	// a heavy round: the harder, the likelier
	if (local.mod == 18 || local.mod == 19 || local.mod == 27)
	{
		if (local.damage >= 40)
		{
			local.chance = (local.damage - 30) * 0.01
			if (local.chance > 0.6)
				local.chance = 0.6
			if (randomfloat 1 < local.chance)
				end 1
		}
	}
end 0

// Down, and up again.
knockdown:
	local.yaw = self GetLocalYawFromVector self.fact.direction
	local.mod = self.fact.meansofdeath

	if (local.mod == 9 || local.mod == 10 || local.mod == 14 || local.mod == 16 || local.mod == 29)
		local.fall = "opm_down_blast"
	else if (local.yaw > 135 || local.yaw < -135)
		local.fall = "opm_down_front"
	else
		local.fall = "opm_down_back"

	if (getcvar "g_opm_paindebug" == "1")
		println ("opm knockdown: " + local.fall + " damage " + self.fact.damage + " mod " + local.mod)

	// Hit again while down (this thread then starts again from here): he
	// stays where he is, with no new fall.
	if (self.opm_kd_down != 1)
	{
		self.opm_kd_down = 1
		self.opm_kd_ready = 0

		// His box lies down with him: 8 high, as the engine lowers a
		// corpse's, so he is walked over (at 16 the player stepped up onto
		// nothing he could see), and wide enough to take in a man lying any
		// way round, for the shots at him. Left standing, it kept anyone from
		// crossing the spot where he had been.
		self.opm_kd_mins = self.getmins
		self.opm_kd_maxs = self.getmaxs
		self setsize ( -40 -40 0 ) ( 40 40 8 )
		self.blendtime = 0.15
		self setmotionanim local.fall
		self waittill flaggedanimdone
	}

	// Until the client says where his body has come to rest, lying. Each
	// animation is waited out: one let finish unwatched ends his pain, and
	// this thread with it.
	local.start = level.time
	while (self.opm_kd_ready != 1 && level.time - local.start < 5)
	{
		self setmotionanim opm_down_lying
		self waittill flaggedanimdone
	}
	if (getcvar "g_opm_paindebug" == "1")
		println ("opm knockdown: lay " + (level.time - local.start) + " s, told where: " + self.opm_kd_ready)

	if (self.opm_kd_ready == 1)
	{
		switch (self.opm_kd_face)
		{
		case 0:
			local.kind = "front"
			break
		case 2:
			local.kind = "left"
			break
		case 3:
			local.kind = "right"
			break
		default:
			local.kind = "back"
			break
		}
	}
	else
	{
		local.kind = "back"
	}

	// One of the get-ups made for the way he lies, at random (generated,
	// anim/opm_getups.scr), or one from his back if there is none.
	local.n = waitthread anim/opm_getups.scr::count local.kind
	if (local.n < 1)
	{
		local.kind = "back"
		local.n = waitthread anim/opm_getups.scr::count local.kind
	}
	local.i = (randomint local.n) + 1

	if (self.opm_kd_ready == 1)
	{
		// Where that get-up starts his pelvis, and which way his head points,
		// relative to where he will stand facing; turned so its body lies as
		// his does, and moved so its pelvis is where his is.
		local.at = waitthread anim/opm_getups.scr::data local.kind local.i
		local.facing = self.opm_kd_yaw - local.at[2]
		local.fwd = angles_toforward ( 0 local.facing 0 )
		// (angles_toleft gives the right, whatever its name says: it is
		// AngleVectors' second vector)
		local.right = angles_toleft ( 0 local.facing 0 )
		local.origin = self.opm_kd_pelvis - local.fwd * local.at[0] + local.right * local.at[1]
		local.origin[2] = self.origin[2]

		self.angles = ( 0 local.facing 0 )
		self.origin = local.origin
		self droptofloor
	}

	if (getcvar "g_opm_paindebug" == "1")
		println ("opm knockdown: getting up (" + local.kind + " " + local.i + " of " + local.n + ")")

	// Standing again: his own box back.
	self setsize self.opm_kd_mins self.opm_kd_maxs

	self.blendtime = 0.1
	self setmotionanim ("opm_getup_" + local.kind + local.i)
	self waittill flaggedanimdone

	self.opm_kd_ready = 0
	self.opm_kd_down = 0
end
