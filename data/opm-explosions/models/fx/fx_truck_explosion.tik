TIKI
// OPM: generated by tools/explosions/gen.py (opm-explosions); edit that.
// A map's explosion: plays opm_explosion_large where it is spawned.
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	server
	{
		classname Animate
		notsolid
		rendereffects +dontdraw
	}
}

animations
{
	aaaa dummy2.skc
	idle dummy2.skc
	{
		client
		{
			enter opm_explode large
		}
	}
}
