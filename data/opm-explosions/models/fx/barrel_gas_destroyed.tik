TIKI
// OPM: generated by tools/explosions/gen.py (opm-explosions); edit that.
// The game's barrel_gas_destroyed, which plays opm_explosion_fuel.
setup
{
	scale 0.02
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	server
	{
		classname effectentity
		notsolid
		rendereffects +dontdraw
	}
}

animations
{
	dummy dummy2.skc

	idle dummy2.skc
	{
		server
		{
			first commanddelay .3 ai_event explosion
			first commanddelay .3 anim dummy
		}
		client
		{
			enter sound gas_explode
			enter opm_explode fuel
		}
	}
}
