// The in-game report menu (code/cgame/cg_bugreport.cpp). Opened by the
// report key (bugreport) once a target is locked; Submit runs br_submit.
menu "bugreport" 420 344 NONE 0
align centerx centery
bgcolor 0 0 0 0.85
borderstyle "RAISED"
bgfill 0.05 0.05 0.08 0.85

resource
Label
{
title "REPORT"
name "Default"
rect 12 8 300 24
fgcolor 1.00 0.85 0.30 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
font facfont-20
textalign left
}

resource
Label
{
title "The crosshair target is captured. Pick a type and area, then describe it."
name "Default"
rect 12 34 396 16
fgcolor 0.80 0.80 0.80 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
font verdana-12
textalign left
}

resource
Label
{
title "Type"
name "Default"
rect 12 58 60 20
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.50 0.50 0.50 0.00
borderstyle "NONE"
font verdana-14
textalign left
}

resource
Button
{
title "Bug"
name "Default"
rect 80 58 80 20
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.20 0.22 0.30 1.00
borderstyle "3D_BORDER"
clicksound "sound/menu/scroll.wav"
stuffcommand "set br_type bug"
}

